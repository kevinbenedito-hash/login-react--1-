# Configuração pronta para a API local (server/server.js).
# Para usar outra API, ajuste os valores abaixo e reinicie o npm run dev.

# URL base da API. "/api" passa pelo proxy do Vite e evita erro de CORS em dev.
VITE_API_URL=/api

# Caminho do endpoint de login
VITE_LOGIN_PATH=/auth/login

# Formato do corpo da requisicao: "json" ou "form" (application/x-www-form-urlencoded, estilo OAuth2)
VITE_LOGIN_FORMAT=json

# Nomes dos campos enviados para a API
VITE_USER_FIELD=email
VITE_PASSWORD_FIELD=password

# Somente servidor de desenvolvimento: para onde o proxy /api deve apontar
API_PROXY_TARGET=http://localhost:3001

# Modo demonstracao (sem API nenhuma). Qualquer e-mail e a senha "123456" funcionam.
VITE_USE_MOCK=false

# API local (server/server.js)
API_PORT=3001
JWT_SECRET=troque-este-segredo-em-producao
