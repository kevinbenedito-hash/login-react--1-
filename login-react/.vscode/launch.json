{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Abrir no Chrome (depois de npm run dev)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src"
    },
    {
      "name": "Depurar API (Node)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/server.js",
      "console": "integratedTerminal"
    }
  ]
}
